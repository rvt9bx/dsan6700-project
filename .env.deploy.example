# Deployment profile, for the Jetstream2 instance: copy to .env there with `cp .env.deploy.example .env`.
# The development profile is .env.example. Never commit a real .env.
TMDB_API_KEY=add_tmdb_api_key
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_BATCH_SIZE=64
QDRANT_COLLECTION_PREFIX=movies
UPSERT_BATCH_SIZE=256

# Start Caddy too, so the app is served over HTTPS at the instance's name
COMPOSE_PROFILES=proxy
MOVIEREC_DOMAIN=team01-app.cis240466.projects.jetstream-cloud.org
# The app's port 8080 listens on this machine only; from outside, only Caddy's 80 and 443 answer
APP_BIND=127.0.0.1
