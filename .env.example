TMDB_API_KEY=add_tmdb_api_key
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_CACHE_DIR=/models
EMBED_BATCH_SIZE=64
QDRANT_URL=http://localhost:6333 # use qdrant for local qdrant on disk, or :memory: for in memory, localhost address for docker
QDRANT_COLLECTION_PREFIX=movies
UPSERT_BATCH_SIZE=256
LOG_DIR=logs
LOG_LEVEL=INFO # DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_JSON=true # false prints readable text instead of JSON (for development)
RECOMMEND_RATE_PER_MINUTE=10 # POST /recommend calls per client per minute; more get a 429
RECOMMEND_BURST=5 # calls allowed in a quick burst before the rate applies
MAX_JOBS_IN_FLIGHT=8 # recommendation jobs pending or running at once; more get a 503
JOB_TTL_SECONDS=3600 # how long finished results are kept
MAX_BODY_BYTES=32768 # larger request bodies get a 413
METRICS_TOKEN= # bearer token for GET /metrics, at least 16 characters (python3 -c "import secrets; print(secrets.token_urlsafe(32))")
