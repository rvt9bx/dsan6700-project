{
  "uid": "movierec",
  "title": "Eenie Meenie Movies",
  "description": "Requests, recommendation jobs, quality and the SLO for the movierec app. Generated into git; edit the JSON, not the UI.",
  "tags": [
    "movierec"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Service level objective: 99% of recommendations complete within 5 s (set the time range to 28 days to see the SLO window)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Good recommendations (SLI)",
      "description": "Share of recommendation jobs in the selected range that completed within 5 s. Jobs that failed, took longer, or were refused with a 5xx count as bad. Target: 99%. See docs/SLO.md.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(movierec_recommend_job_duration_seconds_bucket{outcome=\"completed\",le=\"5.0\"}[$__range])) / (sum(increase(movierec_recommend_job_duration_seconds_count[$__range])) + (sum(increase(movierec_http_requests_total{endpoint=\"/recommend\",method=\"POST\",status=~\"5..\"}[$__range])) or vector(0)))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "mappings": [],
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error budget left",
      "description": "How much of the 1% allowed bad recommendations is unused in the selected range. Below 0% the SLO is missed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (1 - (sum(increase(movierec_recommend_job_duration_seconds_bucket{outcome=\"completed\",le=\"5.0\"}[$__range])) / (sum(increase(movierec_recommend_job_duration_seconds_count[$__range])) + (sum(increase(movierec_http_requests_total{endpoint=\"/recommend\",method=\"POST\",status=~\"5..\"}[$__range])) or vector(0))))) / 0.01",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "mappings": [],
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Recommendations (good / all)",
      "description": "Counts behind the SLI, in the selected range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 5
