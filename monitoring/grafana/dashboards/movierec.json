      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(movierec_recommend_job_duration_seconds_bucket{outcome=\"completed\",le=\"5.0\"}[$__range]))",
          "legendFormat": "good",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(movierec_recommend_job_duration_seconds_count[$__range])) + (sum(increase(movierec_http_requests_total{endpoint=\"/recommend\",method=\"POST\",status=~\"5..\"}[$__range])) or vector(0)))",
          "legendFormat": "all",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
